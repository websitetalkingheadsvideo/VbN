# Large PDF files (too large for git, but track other files in these folders)
*.pdf
*.PDF
# Note: reference/Books/ and reference/Scenes/ folders themselves can contain tracked files (just not PDFs)

# Character images
reference/Characters/Images/
*.webp
*.jpg
*.jpeg
*.png

# Always track JSON files in Characters folder (even if *.json is ignored elsewhere)
!reference/Characters/*.json
!reference/Characters/**/*.json

# Temporary files
*.tmp
*.temp
*~

# IDE files
.vscode/
.idea/
*.swp
*.swo
.cursor/
_notes/

# OS files
.DS_Store
Thumbs.db
sync_config.jsonc

# Environment files with API keys
.env
config.env
node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
node_modules/
# Environment variables
